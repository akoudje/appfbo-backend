PORT=4000
DATABASE_URL=postgresql://postgres:password@localhost:5432/appfbo
NODE_ENV=development
JWT_SECRET=replace_with_strong_random_secret
JWT_EXPIRES_IN=7d
CUSTOMER_JWT_SECRET=replace_with_another_strong_random_secret
CUSTOMER_JWT_EXPIRES_H=12
CUSTOMER_OTP_EXPIRES_MIN=10
CUSTOMER_OTP_PEPPER=replace_with_strong_random_pepper

ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_TOKEN_URL=https://api.orange.com/oauth/v3/token
ORANGE_SENDER_ADDRESS=tel:+225894650
ORANGE_SENDER_NUMBER=894650
ORANGE_SMS_TIMEOUT_MS=20000
ORANGE_SMS_TRANSIENT_RETRIES=1
ORANGE_SMS_RETRY_DELAY_MS=1500
BACKEND_PUBLIC_URL=https://appfbo-backend.onrender.com

# Burkina Faso - séparé des clés Côte d'Ivoire.
# Les envois BFA utilisent uniquement ces variables.
ORANGE_CLIENT_ID_BFA=
ORANGE_CLIENT_SECRET_BFA=
ORANGE_TOKEN_URL_BFA=https://api.orange.com/oauth/v3/token
ORANGE_SENDER_ADDRESS_BFA=tel:+2260000
ORANGE_SENDER_NUMBER_BFA=0000

ORANGE_WEBHOOK_TOKEN=
MAILERSEND_WEBHOOK_TOKEN=
WAVE_WEBHOOK_SECRET=
WAVE_WEBHOOK_SIGNATURE_HEADER=wave-signature

# WhatsApp via MailerSend (add-on payant, à activer + connecter dans leur
# dashboard : WhatsApp -> Phone numbers). Nécessite un token avec le scope
# whatsapp_full (peut être le même que MAILERSEND_API_KEY ou un token dédié).
# Tant que la clé et l'expéditeur sont absents, le canal WHATSAPP reste simulé.
# Une fois renseignés, un modèle manquant fait échouer l'envoi WhatsApp
# (statut FAILED, erreur MAILERSEND_WHATSAPP_TEMPLATE_MISSING).
MAILERSEND_WHATSAPP_API_KEY=
MAILERSEND_WHATSAPP_SENDER=
MAILERSEND_WHATSAPP_WEBHOOK_SECRET=
# ID des modèles approuvés par Meta (dashboard MailerSend -> WhatsApp ->
# Templates ; aucune API pour les créer), dans l'ordre des modèles 1 à 13 de
# docs/whatsapp-templates.md (fbo_invoice_wave ... fbo_order_fulfilled_shipping).
MAILERSEND_WHATSAPP_TEMPLATE_INVOICE_WAVE=
MAILERSEND_WHATSAPP_TEMPLATE_INVOICE_CASH=
MAILERSEND_WHATSAPP_TEMPLATE_INVOICE_BANK=
MAILERSEND_WHATSAPP_TEMPLATE_REMINDER_WAVE=
MAILERSEND_WHATSAPP_TEMPLATE_REMINDER_CASH=
MAILERSEND_WHATSAPP_TEMPLATE_REMINDER_BANK=
MAILERSEND_WHATSAPP_TEMPLATE_PAYMENT_CONFIRMED=
MAILERSEND_WHATSAPP_TEMPLATE_PREPARATION_STARTED=
MAILERSEND_WHATSAPP_TEMPLATE_ORDER_READY_PICKUP=
MAILERSEND_WHATSAPP_TEMPLATE_ORDER_READY_SHIPPING=
MAILERSEND_WHATSAPP_TEMPLATE_SHIPPING_PAYMENT=
MAILERSEND_WHATSAPP_TEMPLATE_ORDER_FULFILLED_PICKUP=
MAILERSEND_WHATSAPP_TEMPLATE_ORDER_FULFILLED_SHIPPING=

# Email SMTP (MailerSend / SendGrid / SMTP classique)
SMTP_HOST=smtp.mailersend.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=FOREVER
EMAIL_BRAND_LOGO_URL=https://appfbo-frontend.vercel.app/logo-forever.png
EMAIL_SIMULATE=false
NOTIFICATION_DEDUP_WINDOW_SECONDS=60

# Sécurité (laisser à false en production)
ALLOW_HEADER_AUTH=false
ALLOW_QUERY_TOKEN_AUTH=false
ENABLE_SEED_SUPER_ADMIN=false

# CORS
# Liste d'origines front autorisées, séparées par des virgules
# Exemple:
# ALLOWED_ORIGINS=https://admin.forevercivstore.com,https://www.forevercivstore.com,https://forevercivstore.com
ALLOWED_ORIGINS=
# Patterns wildcard pour sous-domaines (syntaxe simple avec *)
# Exemple:
# ALLOWED_ORIGIN_PATTERNS=https://*.forevercivstore.com,https://*.vercel.app
ALLOWED_ORIGIN_PATTERNS=
